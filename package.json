    "glb": "node tools/export-glb.mjs",
    "bundle": "node tools/bundle-single.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "playwright-core": "^1.50.0",
    "three": "0.186.1"
  }
}
