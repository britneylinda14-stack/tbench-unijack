{
  "name": "unijack-3d",
  "private": true,
  "version": "0.1.0",
  "description": "Photo-anchored, illustrative 3D model of the UniJack kit (base board, Mercury module, PeriBoard). Not CAD.",
  "type": "module",
  "scripts": {
